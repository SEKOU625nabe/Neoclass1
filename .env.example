# ============================================================
# NEOCLASS - Configuration des variables d'environnement
# Copiez ce fichier vers .env et remplissez les valeurs
# ============================================================

# Port du serveur
PORT=3000

# Environment (development | production)
NODE_ENV=development

# ============================================================
# SÉCURITÉ
# ============================================================

# Origines autorisées pour CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================
# API KEYS (NE JAMAIS COMMITTER CES VALEURS)
# ============================================================

# Mistral AI (pour l'assistant Darx)
const MISTRAL_API_KEY = process.env.MISTRAL_API_KEY;
const AGENT_ID = process.env.MISTRAL_AGENT_ID;

# ============================================================
# FIREBASE (optionnel - pour Firebase Admin SDK côté serveur)
# ============================================================
# FIREBASE_PROJECT_ID=neoclass-73b86
# FIREBASE_PRIVATE_KEY_PATH=./firebase-service-account.json

# ============================================================
# PAIEMENT (pour production)
# ============================================================
# ORANGE_MONEY_API_KEY=
# WAVE_API_KEY=
# MTN_MOMO_API_KEY=
