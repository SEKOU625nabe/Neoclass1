# .env — Variables d'environnement Neoclass
# ✅ CE FICHIER NE DOIT JAMAIS ÊTRE COMMITÉ SUR GITHUB
# Ajoute .env dans ton .gitignore !

# ============================================================
# 🤖 MISTRAL AI — Clés secrètes (JAMAIS dans le frontend)
# ============================================================
MISTRAL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MISTRAL_AGENT_ID=ag_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# 🔥 FIREBASE ADMIN — Pour vérifier les tokens côté serveur
# Ces valeurs viennent de : Firebase Console → Paramètres du projet
# → Comptes de service → Générer une nouvelle clé privée
# ============================================================
FIREBASE_PROJECT_ID=neoclass-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@neoclass-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXXX\n-----END PRIVATE KEY-----\n"

# ============================================================
# 🌐 FRONTEND
# ============================================================
FRONTEND_URL=https://neoclass.netlify.app

# ============================================================
# ⚙️ SERVEUR
# ============================================================
PORT=3001
NODE_ENV=production
