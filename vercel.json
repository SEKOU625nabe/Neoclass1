{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "echo \"Aucune installation requise (site statique)\"",
  "outputDirectory": ".",
  "trailingSlash": false,
  "functions": {
    "api/*.js": { "maxDuration": 25 }
  },
  "rewrites": [
    { "source": "/.netlify/functions/darx", "destination": "/api/darx" },
    { "source": "/.netlify/functions/darx-vision", "destination": "/api/darx-vision" },
    { "source": "/.netlify/functions/mistral-api", "destination": "/api/darx" },
    { "source": "/", "destination": "/Neoclass3.html" },
    { "source": "/app", "destination": "/Neoclass3.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(self), camera=(self)" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/Neoclass3.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
