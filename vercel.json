{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/\\.netlify/functions/darx", "dest": "/api/darx" },
    { "src": "/\\.netlify/functions/darx-vision", "dest": "/api/darx-vision" },
    { "src": "/\\.netlify/functions/mistral-api", "dest": "/api/darx" },

    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },

    { "handle": "filesystem" },

    { "src": "/", "dest": "/Neoclass3.html" },
    { "src": "/app", "dest": "/Neoclass3.html" },
    { "src": "/(.*)", "dest": "/Neoclass3.html" }
  ]
}
