{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/.netlify/functions/darx", "destination": "/api/darx" },
    { "source": "/.netlify/functions/darx-vision", "destination": "/api/darx-vision" },
    { "source": "/.netlify/functions/mistral-api", "destination": "/api/darx" },
    { "source": "/", "destination": "/Neoclass3.html" },
    { "source": "/app", "destination": "/Neoclass3.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
